<dialog id="dg" aria-labelledby="dt"><button class="x" aria-label="Close project" id="dx">×</button><div class="in" id="db"></div></dialog>
<script>
// ===== CONFIG: edit these =====
const CONFIG={email:"",whatsapp:"",buyUrl:"",formEndpoint:"",social:{linkedin:"",github:"",youtube:"",x:"",instagram:""},links:{sample:"",learn:"",article0:"",article1:"",article2:"",article3:"",github0:"",demo0:"",paper0:"",github1:"",paper1:""}};
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
$$('[data-logo]').forEach(i=>i.src=$('.logo').src);
const P=[
["Deepfake Detection & Adversarial Robustness Analyzer","AI / Machine Learning / Cybersecurity","An AI-based system for detecting manipulated media and analyzing the robustness of deepfake detection models against adversarial attacks.",["Python","TensorFlow","CNN","MobileNetV2","FGSM","Computer Vision"],1],
["Domain-Specific Machine Translation","AI / NLP / Research","A domain-specific English-Shona machine translation research project focused on legal and healthcare applications.",["NLLB-200","LoRA","QLoRA","NLP","Python","Hugging Face"],2],
["Multi-Modal Crop Disease Prediction","AI / Agriculture","A multimodal machine learning system combining plant imagery and environmental data to support crop disease prediction.",["Python","TensorFlow","MobileNetV2","Machine Learning"],3],
["Blockchain-Based Land Registry","Blockchain / Web3 / Civic Technology","A blockchain-based land registry concept designed to improve transparency, ownership verification and the integrity of land records.",["Blockchain","Smart Contracts","Web Applications","GIS"],4],
["Machine Learning-Based Predictive Maintenance","Machine Learning / Industrial AI","A machine learning framework for predictive maintenance and fault prediction in industrial equipment.",[],5],
["Global B2B Trading Platform","E-commerce / Global Trade / Technology","A digital marketplace concept designed to connect international buyers and sellers of commodities.",[],6]];
const Q=["Can a deepfake detector still be trusted when it is attacked?","Can machine translation serve Shona speakers in law and healthcare?","Can plant images and environmental data predict crop disease?","Can land records be made transparent and tamper-resistant?","Can machines warn us before industrial equipment fails?","Can global commodity trade be simpler for buyers and sellers?"];
const art=n=>{const s=[`<path d="M0 90 Q60 20 120 70 T240 40 T360 80" stroke="#E5B85C" fill="none" stroke-width="2"/><circle cx="120" cy="70" r="5" fill="#E5B85C"/>`,`<g stroke="#C9963E" fill="none"><path d="M40 30h120M40 60h200M40 90h150"/><path d="M200 30h120M260 60h80M220 90h120" stroke="#E5B85C"/></g>`,`<g fill="#C9963E" opacity=".8"><circle cx="90" cy="60" r="34"/><circle cx="150" cy="80" r="26" opacity=".6"/></g><path d="M200 100V40l50 30 50-30v60" stroke="#F3D38A" fill="none" stroke-width="2"/>`,`<g stroke="#C9963E" fill="#101B2E"><rect x="50" y="40" width="50" height="50"/><rect x="150" y="30" width="50" height="50"/><rect x="250" y="55" width="50" height="50"/><path d="M100 65l50-10M200 55l50 25" fill="none"/></g>`,`<path d="M20 100l40-30 40 10 40-50 40 40 40-20 40 30 40-60" stroke="#E5B85C" fill="none" stroke-width="2"/>`,`<circle cx="180" cy="60" r="40" stroke="#C9963E" fill="none"/><path d="M140 60h80M180 20q30 40 0 80M180 20q-30 40 0 80" stroke="#E5B85C" fill="none"/>`];
return `<svg viewBox="0 0 360 120" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><defs><linearGradient id="g${n}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#13223c"/><stop offset="1" stop-color="#050B16"/></linearGradient></defs><rect width="360" height="120" fill="url(#g${n})"/><path d="M0 40H360M0 80H360M90 0V120M180 0V120M270 0V120" stroke="#C9963E" stroke-opacity=".1"/>${s[n-1]}</svg>`};
const tg=t=>t.length?t.map(x=>`<span>${x}</span>`).join(''):'<span>[PLACEHOLDER — ADD INFORMATION]</span>';
const row=(p,i)=>`<button class="pr" data-i="${i}" aria-label="Open case study: ${p[0]}"><span class="n">0${p[4]}</span><div><span class="lbl">${p[1]}</span><h3>${p[0]}</h3><p class="q2">${Q[p[4]-1]}</p><div class="tags">${p[3].slice(0,4).map(t=>`<span>${t}</span>`).join('')}</div></div><div class="th">${art(p[4])}</div></button>`,f=P[0];
$('#pg').innerHTML=`<button class="ft" data-i="0" aria-label="Open case study: ${f[0]}"><div class="vs">${art(1)}</div><div class="tx"><span class="lbl">Featured project · ${f[1]}</span><h3>${f[0]}</h3><p class="q2">${Q[0]}</p><p>${f[2]}</p><div class="tags">${f[3].map(t=>`<span>${t}</span>`).join('')}</div><span class="ar" style="color:var(--bg)">VIEW PROJECT →</span></div></button><div class="pj">${P.slice(1).map((p,i)=>row(p,i+1)).join('')}</div>`;
$$('[data-i]').forEach(c=>c.onclick=()=>{const i=+c.dataset.i,p=P[i],L=['github','demo','paper'].filter(k=>CONFIG.links[k+i]);$('#db').innerHTML=`<span class="lbl">${p[1]}</span><h2 id="dt">${p[0]}</h2><p class="q2" style="font-size:22px">${Q[p[4]-1]}</p><div style="margin:16px 0">${art(p[4])}</div><h4>Overview</h4><p>${p[2]}</p><h4>Technology stack</h4><div class="tags">${tg(p[3])}</div><h4>Case study</h4><p class="mut">Problem, solution, architecture, results and future work: [PLACEHOLDER — ADD INFORMATION]</p>${L.length?`<div class="ctas">${L.map(k=>`<a class="btn o" target="_blank" rel="noopener" href="${CONFIG.links[k+i]}">${k}</a>`).join('')}</div>`:''}`;$('#dg').showModal()});
$('#dx').onclick=()=>$('#dg').close();$('#dg').onclick=e=>{if(e.target.id==='dg')e.target.close()};
$('#arts').innerHTML=[["The Power of Purpose in a Student's Journey","Purpose"],["Cybersecurity: Guarding Your Digital Life","Cybersecurity"],["Lessons From My Journey in India","Personal"],["Building With Purpose","Ideas"]].map((a,i)=>`<article class="art"><span class="lbl">${a[1]}</span><h3>${a[0]}</h3><p class="mut">[PLACEHOLDER — ADD DATE, READING TIME AND EXCERPT]</p><a class="ar" data-k="article${i}" href="#" hidden>READ ARTICLE →</a></article>`).join('');
const K={"Programming":["Python","C++","Java","JavaScript"],"AI / ML":["TensorFlow","PyTorch","Scikit-learn","Pandas","NumPy","OpenCV"],"Cybersecurity":["Linux","Kali Linux","Splunk","Wireshark","Burp Suite","Networking"],"Web":["React","Svelte","Tailwind CSS","Node.js","Firebase","PostgreSQL"],"Tools":["Git","GitHub","Docker","VS Code","Figma"]};
$('#sk').innerHTML=Object.entries(K).map(([k,v])=>`<div class="rv"><h3>${k.toUpperCase()}</h3>${v.map(t=>`<span>${t}</span>`).join('')}</div>`).join('');
$('#sv').innerHTML=[["AI / Machine Learning","Models and systems that learn from data."],["Cybersecurity","Security analysis and defensive thinking."],["Web Development","Fast, accessible, well-crafted websites and apps."],["Research & Technical Writing","Clear writing on complex technical topics."],["Technology Solutions","Practical solutions for real problems."],["Technology Consulting","Guidance on technology decisions."],["Digital Product Development","From idea to working product."]].map((s,i)=>`<div${i?"":' class="lead"'}><i class="dm"></i><h3>${s[0]}</h3><p>${s[1]}</p><a class="ar" href="#contact">LEARN MORE →</a></div>`).join('');
$$('[data-social]').forEach(a=>{const u=CONFIG.social[a.dataset.social];if(u){a.href=u;a.target="_blank";a.rel="noopener"}else a.hidden=true});
$$('[data-k]').forEach(a=>{const u=CONFIG.links[a.dataset.k];if(u){a.href=u;a.hidden=false;a.target='_blank';a.rel='noopener'}});
if(CONFIG.buyUrl){const b=$('#buy');b.href=CONFIG.buyUrl;b.target='_blank';b.rel='noopener';b.innerHTML='Buy the book <span>→</span>'}else $('#buy').addEventListener('click',()=>{$('#r').value='Writing';$('#s').value='The Zimbabwean-India Dream'});
if(CONFIG.email){$('#em').textContent=CONFIG.email;$('#em').href='mailto:'+CONFIG.email}else $('#em').onclick=e=>e.preventDefault();
if(CONFIG.whatsapp)$('#wa').href='https://wa.me/'+CONFIG.whatsapp;else $('#wa').hidden=true;
const hd=$('#hd');addEventListener('scroll',()=>{hd.classList.toggle('s',scrollY>40);$('#pb').style.transform=`scaleX(${scrollY/((document.documentElement.scrollHeight-innerHeight)||1)})`},{passive:true});
const mm=$('#mm'),mt=o=>{if(o)setTimeout(()=>$('#cl').focus(),60);mm.classList.toggle('o',o);mm.setAttribute('aria-hidden',!o);$('#hb').setAttribute('aria-expanded',o)};
$('#hb').onclick=()=>mt(true);$('#cl').onclick=()=>mt(false);$('#more').onclick=e=>{e.preventDefault();mt(true)};$$('#mm a').forEach(a=>a.addEventListener('click',()=>mt(false)));
addEventListener('keydown',e=>{if(e.key==='Escape')mt(false)});const links=$$('nav.d a,.bn a[href^="#"]:not(#more)');
$$('main section[id]').forEach(s=>new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)links.forEach(l=>l.classList.toggle('on',l.getAttribute('href')==='#'+s.id))}),{rootMargin:'-45% 0px -50% 0px'}).observe(s));
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.1});$$('.rv').forEach(r=>{r.style.transitionDelay=([...r.parentNode.children].filter(c=>c.classList.contains('rv')).indexOf(r)*90)+'ms';io.observe(r)});
$('#fm').onsubmit=async e=>{e.preventDefault();let ok=true;const st=$('#st');st.className='';
['n','e','s','m'].forEach(id=>{const i=$('#'+id),er=i.parentNode.querySelector('.er');let m='';if(!i.value.trim())m='This field is required.';else if(id==='e'&&!/^\S+@\S+\.\S+$/.test(i.value))m='Enter a valid email address.';er.textContent=m;i.setAttribute('aria-invalid',!!m);if(m)ok=false});
if(!ok)return;const b=$('#sb'),bt=b.querySelector('b');b.disabled=true;bt.textContent='Sending…';
const d={name:$('#n').value,email:$('#e').value,phone:$('#p').value,reason:$('#r').value,subject:$('#s').value,message:$('#m').value};
try{if(CONFIG.formEndpoint){const r=await fetch(CONFIG.formEndpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});if(!r.ok)throw 0}
else if(CONFIG.email){location.href=`mailto:${CONFIG.email}?subject=${encodeURIComponent(d.reason+': '+d.subject)}&body=${encodeURIComponent(d.message+'\n\n'+d.name+' '+d.phone)}`}
else throw 0;
st.className='ok';st.textContent='Message sent. Thank you, I will reply soon.';$('#fm').reset()}catch{st.className='bad';st.textContent='Message not sent. Add an email or form endpoint in CONFIG, then try again.'}
b.disabled=false;bt.textContent='Send message'};
</script></body></html>
