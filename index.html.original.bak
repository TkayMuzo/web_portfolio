<div><label for="p">Phone</label><input id="p" type="tel" autocomplete="tel"></div><div><label for="r">Reason for contact</label><select id="r"><option>Project Collaboration</option><option>Research</option><option>Business</option><option>Speaking</option><option>Technology</option><option>Writing</option><option>Other</option></select></div>
<div class="f"><label for="s">Subject</label><input id="s" required><span class="er"></span></div><div class="f"><label for="m">Message</label><textarea id="m" rows="5" required></textarea><span class="er"></span></div>
<div class="f"><button class="btn g" id="sb" type="submit"><b style="font-weight:600">Send message</b> <span>→</span></button></div><div id="st" role="status" aria-live="polite"></div></form></div></section>
</main>
<footer><div class="dv"><i></i></div><img class="logo" style="margin:0 auto;height:88px" data-logo alt="TM monogram"><h3 class="fn">Takudzwa<br>Muzovaka</h3><p class="lbl" style="margin-top:16px">Excellence with purpose</p><p class="pip">Purpose &nbsp;|&nbsp; Innovation &nbsp;|&nbsp; Impact</p>
