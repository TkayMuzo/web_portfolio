<style>
:root{--navy:#050B16;--dn:#0A1324;--sec:#101B2E;--gold:#C9963E;--gd:#8A6220;--bg:#E5B85C;--lg:#F3D38A;--ww:#F7F5F0;--txt:#111827;--mut:#6B7280;--serif:'Playfair Display',Georgia,serif;--sans:'Inter',system-ui,sans-serif;--safe-t:env(safe-area-inset-top,0px);--safe-b:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box;margin:0}html{scroll-behavior:smooth;scroll-padding-top:80px}
body{font-family:var(--sans);background:var(--navy);color:var(--txt);line-height:1.7;overflow-x:hidden}
img{max-width:100%;display:block}a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid var(--bg);outline-offset:3px}
.w{max-width:1200px;margin:0 auto;padding:0 24px}
.lbl{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);font-weight:600}
h1,h2,h3{font-family:var(--serif);font-weight:500;line-height:1.1}
h2{font-size:clamp(28px,3.6vw,42px);margin:10px 0 16px;max-width:820px}
section{padding:clamp(72px,9vw,128px) 0}.dark{background:var(--navy);color:#fff}.dk2{background:var(--dn);color:#fff}.light{background:var(--ww)}
.mut{color:var(--mut)}.dark .mut,.dk2 .mut{color:#9AA5B8}
.btn{display:inline-flex;align-items:center;gap:8px;padding:14px 26px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:600;border:1px solid var(--gold);cursor:pointer;font-family:var(--sans);transition:.25s;min-height:46px;background:none;color:inherit}
.btn.g{background:var(--bg);color:var(--navy);border-color:var(--bg)}.btn.g:hover{background:var(--lg);border-color:var(--lg)}
.btn.o:hover{background:var(--gold);color:var(--navy)}
.btn span,.ar span{display:inline-block;transition:.25s}.btn:hover span,.card:hover .ar span{transform:translateX(5px)}
header{position:fixed;top:0;left:0;right:0;z-index:50;padding-top:var(--safe-t);transition:.3s}
header.s{background:rgba(5,11,22,.94);backdrop-filter:blur(10px);border-bottom:1px solid rgba(201,150,62,.2)}
.nv{display:flex;align-items:center;justify-content:space-between;height:72px;gap:16px}
.logo{height:46px;width:auto}
nav.d{display:flex;gap:24px}nav.d a{font-size:13px;color:#cfd6e4;padding:6px 0;position:relative}
nav.d a::after{content:"";position:absolute;left:0;bottom:0;height:2px;width:0;background:var(--bg);transition:.3s}
nav.d a:hover::after,nav.d a.on::after{width:100%}nav.d a.on{color:#fff}
.hb{display:none;background:none;border:0;color:#fff;font-size:28px;width:46px;height:46px;cursor:pointer}
#mm{position:fixed;inset:0;background:var(--navy);z-index:60;padding:calc(24px + var(--safe-t)) 28px 28px;transform:translateX(100%);transition:.35s;display:flex;flex-direction:column;gap:6px;overflow:auto;visibility:hidden}
#mm.o{transform:none;visibility:visible}#mm a.l{font-family:var(--serif);font-size:26px;color:#fff;padding:10px 0;border-bottom:1px solid #1b2942}
.bn{display:none;position:fixed;bottom:0;left:0;right:0;z-index:55;background:rgba(5,11,22,.97);border-top:1px solid rgba(201,150,62,.3);padding:6px 4px calc(6px + var(--safe-b));justify-content:space-around}
.bn a{color:#9AA5B8;font-size:11px;padding:4px 10px;min-width:56px;text-align:center;min-height:44px}.bn a b{display:block;font-size:17px;font-weight:400}.bn a.on{color:var(--bg)}
.hero{min-height:100vh;display:flex;align-items:center;background:radial-gradient(ellipse at 75% 40%,#13223c,var(--navy) 65%);padding:110px 0 70px;overflow:hidden}
.hg{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:center}
.hero h1{font-size:clamp(50px,7.6vw,100px);line-height:1.02;letter-spacing:-.015em;margin:22px 0 26px}.hero h1 em{color:var(--bg);font-style:normal}
.hero p.sub{max-width:520px;color:#cbd3e1;font-size:17px}.ctas{display:flex;flex-wrap:wrap;align-items:center;gap:14px 24px;margin:32px 0 26px}
.soc{display:flex;gap:10px}.soc a{width:44px;height:44px;border:1px solid #2a3a57;display:grid;place-items:center;font-size:12px;font-weight:600;color:#cfd6e4;transition:.25s}.soc a:hover{border-color:var(--bg);color:var(--bg)}
.pf{position:relative;justify-self:end;width:100%;max-width:540px;aspect-ratio:4/5}
.pf::before{content:"";position:absolute;inset:-30px;background:radial-gradient(circle,rgba(229,184,92,.28),transparent 65%)}
.pf .fr{position:absolute;inset:0;overflow:hidden;border-bottom:3px solid var(--gold)}
.pf img{width:100%;height:100%;object-fit:cover;object-position:50% 20%;animation:rv 1.4s ease both}
.pf .fr::after{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 65% 75% at 55% 50%,transparent 45%,rgba(5,11,22,.92) 100%),linear-gradient(0deg,rgba(5,11,22,.85),transparent 35%)}
.stmt{position:absolute;left:22px;bottom:28px;z-index:2;border-left:3px solid var(--gold);padding-left:14px;font-family:var(--serif);font-size:22px;line-height:1.25;color:#fff}
@keyframes rv{from{opacity:0;transform:scale(1.06)}to{opacity:1;transform:none}}
@keyframes up{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
.hero h1,.hero .lbl,.hero .sub,.ctas{animation:up .9s ease both}.hero h1{animation-delay:.15s}.hero .sub{animation-delay:.3s}.ctas{animation-delay:.45s}
.ab{display:grid;grid-template-columns:.85fr 1.15fr;gap:56px;align-items:center}
.ab .ph{position:relative}.ab .ph img{width:100%;aspect-ratio:4/5;object-fit:cover;object-position:50% 12%}
.q{position:absolute;left:-18px;bottom:-24px;right:30px;background:var(--navy);color:#fff;padding:22px 24px;border-left:3px solid var(--gold)}
.q p{font-family:var(--serif);font-size:20px;line-height:1.3}.q small{color:var(--bg);font-size:12px;letter-spacing:.1em}
.facts{list-style:none;padding:0;margin:22px 0 30px;display:grid;grid-template-columns:1fr 1fr;gap:10px 20px}.facts li{padding-left:16px;position:relative;font-size:15px}.facts li::before{content:"";position:absolute;left:0;top:10px;width:6px;height:6px;background:var(--gold);transform:rotate(45deg)}
.vals{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#1b2942;margin-top:32px;border:1px solid #1b2942}
.vals div{background:var(--dn);padding:32px 26px}.vals b{font-family:var(--serif);color:var(--gold);font-size:34px;font-weight:500}.vals h3{font-size:20px;margin:10px 0 8px}
.tags{display:flex;flex-wrap:wrap;gap:6px}.tags span{font-size:11px;padding:3px 10px;border:1px solid #2a3a57;color:#cfd6e4}
.ft{display:grid;grid-template-columns:1.25fr 1fr;border:1px solid #223353;margin-top:40px;background:var(--dn);text-align:left;color:#fff;font:inherit;cursor:pointer;padding:0;width:100%;transition:.3s}
.ft:hover,.ft:focus-visible{border-color:var(--bg)}.ft .vs{overflow:hidden;min-height:300px}.ft:hover svg{transform:scale(1.05)}
.ft .tx{padding:44px 40px;display:flex;flex-direction:column;gap:14px;justify-content:center}.ft h3{font-size:32px}.ft p{color:#9AA5B8}
.pj{border-top:1px solid #1b2942;margin-top:28px}
.pr{display:grid;grid-template-columns:56px 1fr 160px;gap:8px 28px;align-items:center;width:100%;text-align:left;background:none;border:0;border-bottom:1px solid #1b2942;color:#fff;font:inherit;padding:26px 0;cursor:pointer;position:relative;transition:.3s}
.pr::before{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--bg);transform:scaleY(0);transition:.3s}
.pr:hover,.pr:focus-visible{background:rgba(201,150,62,.06);padding-left:20px}.pr:hover::before,.pr:focus-visible::before{transform:none}
.pr .n{font-family:var(--serif);font-size:28px;color:var(--gold)}.pr h3{font-size:24px;margin:4px 0 6px}.pr p{font-size:14px;color:#9AA5B8;max-width:560px;margin-bottom:10px}
.pr .th{aspect-ratio:16/10;overflow:hidden;border:1px solid #223353}.pr:hover svg{transform:scale(1.1)}
.pr svg,.ft svg{width:100%;height:100%;display:block;transition:transform .7s}
dialog .tags span{border-color:#2a3a57;color:#cfd6e4}
.ar{color:var(--gold);font-weight:600;font-size:12px;letter-spacing:.14em}
dialog{border:1px solid var(--gold);background:var(--navy);color:#fff;max-width:820px;width:calc(100% - 32px);max-height:90vh;padding:0;margin:auto;overflow:auto}
dialog::backdrop{background:rgba(5,11,22,.85)}dialog .in{padding:36px}dialog h2{font-size:32px}dialog h4{color:var(--bg);font-size:11px;letter-spacing:.24em;text-transform:uppercase;margin:22px 0 6px}
dialog .x{position:sticky;float:right;top:6px;background:none;border:0;color:#fff;font-size:30px;width:46px;height:46px;cursor:pointer}
.wr{display:grid;grid-template-columns:.8fr 1.2fr;gap:56px;margin-top:40px;align-items:center}
.bk{transform:rotate(-2.5deg);transition:transform .6s cubic-bezier(.2,.7,.2,1);position:relative;aspect-ratio:2/3;width:100%;max-width:330px;margin:0 auto;background:linear-gradient(155deg,#12203a,var(--navy) 70%);box-shadow:28px 30px 60px rgba(10,19,36,.35),inset 8px 0 14px rgba(0,0,0,.35);padding:34px 26px;text-align:center;color:#fff;display:flex;flex-direction:column;justify-content:space-between;align-items:center}
.bk::before{content:"";position:absolute;inset:12px;border:1px solid rgba(201,150,62,.55);pointer-events:none}
.bk img{height:84px;width:auto}.bk h3{font-size:30px;color:var(--lg);line-height:1.1;margin-bottom:12px}.bk small{font-size:10px;letter-spacing:.2em;color:var(--gold);line-height:1.8;display:block}
.arts{margin-top:64px;display:grid;grid-template-columns:repeat(4,1fr);gap:24px}.art{border-top:2px solid var(--gold);padding-top:16px}.art h3{font-size:19px;margin:8px 0}.art p{font-size:14px}.art .m{font-size:12px}
.sk{display:grid;grid-template-columns:repeat(5,1fr);gap:28px;margin-top:36px}.sk h3{font-family:var(--sans);font-size:11px;letter-spacing:.22em;color:var(--gold);margin-bottom:14px;font-weight:600}
.sk span{display:inline-block;margin:0 6px 8px 0;padding:7px 12px;background:var(--sec);border:1px solid #223353;font-size:13px;transition:.25s}.sk span:hover{border-color:var(--bg)}
.tl{margin-top:36px;border-left:1px solid var(--gold);padding-left:32px;display:grid;gap:30px}.tl div{position:relative}.tl div::before{content:"";position:absolute;left:-37px;top:8px;width:9px;height:9px;background:var(--gold);transform:rotate(45deg)}
.tl b{font-size:12px;letter-spacing:.14em;color:var(--gold)}.tl h3{font-size:22px;margin:4px 0}
.sv{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#e2ddd0;border:1px solid #e2ddd0;margin-top:36px}.sv div{background:#fff;padding:30px 24px}.sv b{color:var(--gold);font-size:20px}.sv h3{font-size:20px;margin:12px 0 8px}.sv p{font-size:14px;color:var(--mut);margin-bottom:10px}
.ct{display:grid;grid-template-columns:.8fr 1.2fr;gap:56px}
form{display:grid;grid-template-columns:1fr 1fr;gap:16px}form .f{grid-column:span 2}
label{display:block;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#9AA5B8;margin-bottom:6px}
input,select,textarea{width:100%;background:var(--sec);border:1px solid #223353;color:#fff;padding:13px 14px;font:inherit;font-size:16px;min-height:46px}
input:focus,select:focus,textarea:focus{border-color:var(--bg);outline:0}.er{color:#f0857d;font-size:12px;min-height:16px;display:block}
#st{grid-column:span 2;padding:12px;font-size:14px;display:none}#st.ok{display:block;border:1px solid #4caf7d;color:#8fe0b1}#st.bad{display:block;border:1px solid #f0857d;color:#f0857d}
footer{background:var(--navy);color:#cfd6e4;padding:56px 0 calc(40px + var(--safe-b));text-align:center;border-top:1px solid rgba(201,150,62,.25)}
footer .fl{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 24px;margin:22px 0;font-size:13px}footer .fl a:hover{color:var(--bg)}
.rv{opacity:0;transform:translateY(16px);transition:opacity 1s cubic-bezier(.2,.7,.2,1),transform 1s cubic-bezier(.2,.7,.2,1)}.rv.in{opacity:1;transform:none}
@media(max-width:1000px){.pg,.sv,.arts{grid-template-columns:1fr 1fr}.sk{grid-template-columns:1fr 1fr}.vals{grid-template-columns:1fr 1fr}.hg,.ab,.wr,.ct{grid-template-columns:1fr}.pf{justify-self:center;max-width:380px}.ab .ph{max-width:440px;margin-bottom:30px}nav.d,#cta-top{display:none}.hb{display:block}}
@media(max-width:640px){section{padding:64px 0}.pg,.sv,.arts,.sk,.vals,.facts,form{grid-template-columns:1fr}form .f,#st{grid-column:span 1}body{padding-bottom:64px}.bn{display:flex}.ctas .btn{width:100%;justify-content:center}.stmt{font-size:17px;right:0}dialog .in{padding:26px 20px}.hero{padding-top:90px}}
[hidden]{display:none!important}
.skip{position:absolute;left:12px;top:-60px;z-index:100;background:var(--bg);color:var(--navy);padding:10px 16px;font-weight:600}.skip:focus{top:12px}
.lk{color:#fff;font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:600;padding:12px 2px;border-bottom:1px solid var(--gold);min-height:46px;display:inline-flex;align-items:center;transition:.25s}.lk:hover{color:var(--bg)}
.light .lbl,.light .ar,.light .tl b,.light .btn.o{color:var(--gd)}.light .btn.o{border-color:var(--gd)}.light .btn.g{color:var(--navy)}
.dk2 .sv{background:#1b2942;border-color:#1b2942}.dk2 .sv div{background:var(--dn)}.dk2 .sv p{color:#9AA5B8}.sv div.lead{grid-column:span 2}
dialog .mut{color:#9AA5B8}#contact{border-top:1px solid #1b2942}
@media(max-width:1000px){.ft{grid-template-columns:1fr}.ft .vs{min-height:200px}.hero .pf{order:-1;aspect-ratio:1/1.05;max-width:340px}}
@media(max-width:640px){.pr{grid-template-columns:36px 1fr}.pr .th{display:none}.ft .tx{padding:28px 22px}.sv div.lead{grid-column:auto}.pr:hover{padding-left:12px}}
h1,h2,h3{text-wrap:balance}p{text-wrap:pretty}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
p.lbl::before{content:"";display:inline-block;width:24px;height:1px;background:currentColor;vertical-align:middle;margin-right:12px}footer p.lbl::before{display:none}
#pb{position:fixed;top:0;left:0;height:2px;width:100%;background:var(--bg);transform-origin:0 50%;transform:scaleX(0);z-index:70}
.bd{display:flex;align-items:center;gap:14px}.wm{font-family:var(--serif);font-size:12px;letter-spacing:.34em;text-transform:uppercase;line-height:1.55;color:#fff}
.hero{position:relative}.hero .w{position:relative}.wmk{position:absolute;left:-5%;bottom:-14%;height:92%;width:auto;opacity:.05;pointer-events:none}
.nm{display:flex;align-items:center;gap:16px;animation:up .9s ease both}.nm span{font-family:var(--serif);font-size:15px;letter-spacing:.34em;text-transform:uppercase;color:#fff}.nm::after{content:"";width:56px;height:1px;background:var(--gold)}.nm+.lbl{margin-top:14px}
.pf{isolation:isolate}.pf::after{content:"";position:absolute;inset:16px -16px -16px 16px;border:1px solid rgba(201,150,62,.45);z-index:-1}
.ab .ph::before{content:"";position:absolute;inset:-16px 16px 16px -16px;border:1px solid var(--gd)}
.ab .ph img{position:relative;z-index:1;clip-path:inset(0 0 100% 0);transition:clip-path 1.4s cubic-bezier(.7,0,.2,1)}.ab.in .ph img{clip-path:inset(0)}.q{z-index:2}
p.q2{font-family:var(--serif);font-style:italic;color:var(--lg);font-size:19px;line-height:1.4;margin:4px 0 10px;max-width:520px}
.bk:hover{transform:rotate(0) translateY(-6px)}
.sv div{position:relative;transition:background .3s}.sv div::after{content:"";position:absolute;left:0;right:0;top:0;height:2px;background:var(--bg);transform:scaleX(0);transform-origin:left;transition:transform .5s}.sv div:hover::after{transform:none}.dk2 .sv div:hover{background:var(--sec)}
.dm{display:block;width:9px;height:9px;background:var(--gold);transform:rotate(45deg);margin:4px 0 16px}
.soc{flex-wrap:wrap;gap:8px 24px}.soc a{border:0;width:auto;height:auto;min-height:44px;padding:0;font-size:11px;letter-spacing:.16em;text-transform:uppercase}
.bn a{position:relative;padding-top:10px}.bn a.on::before{content:"";position:absolute;top:0;left:22%;right:22%;height:2px;background:var(--bg)}
.light .btn.o:hover{background:var(--gd);color:#fff}
.dv{display:flex;align-items:center;gap:16px;max-width:360px;margin:0 auto 34px}.dv::before,.dv::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--gold))}.dv::after{transform:scaleX(-1)}.dv i{width:8px;height:8px;background:var(--gold);transform:rotate(45deg)}
.fn{font-size:clamp(24px,4vw,34px);letter-spacing:.32em;text-transform:uppercase;color:#fff;margin-top:20px;line-height:1.35}.pip{font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:#7d889c;margin-top:12px}
@media(max-width:1000px){.wm{display:none}}
@media(max-width:640px){.hero .pf{max-width:280px}.nm span{letter-spacing:.24em;font-size:13px}.nm::after{width:32px}.hero{padding-top:88px}}
